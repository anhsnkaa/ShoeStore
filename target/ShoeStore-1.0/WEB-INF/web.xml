<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <filter>
        <filter-name>ExtensionFileFilter</filter-name>
        <filter-class>controller.filter.ExtensionFileFilter</filter-class>
    </filter>
    <filter>
        <filter-name>AdminFilter</filter-name>
        <filter-class>controller.filter.AdminFilter</filter-class>
    </filter>
    <filter>
        <filter-name>UserFilter</filter-name>
        <filter-class>controller.filter.UserFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>ExtensionFileFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>UserFilter</filter-name>
        <url-pattern>/dashboard</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>UserFilter</filter-name>
        <url-pattern>/payment</url-pattern>
    </filter-mapping>
    <servlet>
        <servlet-name>HomeController</servlet-name>
        <servlet-class>controller.homepage.HomeController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ProductDetailsController</servlet-name>
        <servlet-class>controller.homepage.ProductDetailsController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DashboardServerlet</servlet-name>
        <servlet-class>controller.admin.DashboardServerlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ProductAdminServerlet</servlet-name>
        <servlet-class>controller.admin.ProductAdminServerlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AuthenticationController</servlet-name>
        <servlet-class>controller.authen.AuthenticationController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DashboardUserServerlet</servlet-name>
        <servlet-class>controller.user.DashboardUserServerlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PaymentController</servlet-name>
        <servlet-class>controller.user.PaymentController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>OrderAdminServerlet</servlet-name>
        <servlet-class>controller.admin.OrderAdminServerlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>QnaController</servlet-name>
        <servlet-class>controller.homepage.QnaController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>QnaAdminServerlet</servlet-name>
        <servlet-class>controller.admin.QnaAdminServerlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ReportAdminServerlet</servlet-name>
        <servlet-class>controller.admin.ReportAdminServerlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeController</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProductDetailsController</servlet-name>
        <url-pattern>/product-details</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DashboardServerlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProductAdminServerlet</servlet-name>
        <url-pattern>/admin/product</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AuthenticationController</servlet-name>
        <url-pattern>/authen</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DashboardUserServerlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PaymentController</servlet-name>
        <url-pattern>/payment</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>OrderAdminServerlet</servlet-name>
        <url-pattern>/admin/order</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>QnaController</servlet-name>
        <url-pattern>/qna</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>QnaAdminServerlet</servlet-name>
        <url-pattern>/admin/qna</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ReportAdminServerlet</servlet-name>
        <url-pattern>/admin/report</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>
            home
        </welcome-file>
    </welcome-file-list>
</web-app>
